<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kassa never talks to a network. Remove the permission even if a library asks for it. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- Daily reminder and payments due. Android asks once: when you turn the reminder on, or after saving a card or loan with a due date. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the daily backup and reminder scheduled after the phone restarts. Granted at install, never asked. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the daily reminder arrive on time while the phone dozes. Android 12 and later list it under
         "Alarms & reminders"; Settings offers the switch only if it's off. Without it the reminder can be a little late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".KassaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kassa">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the email app read screenshots attached to feedback. Nothing else is shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <service
            android:name=".data.jobs.DailyJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The daily reminder's alarm. Only Kassa's own alarm reaches it. -->
        <receiver
            android:name=".data.jobs.ReminderReceiver"
            android:exported="false" />

        <!-- The payments-due alarm: one alarm for the earliest notification. Only Kassa's own alarm reaches it. -->
        <receiver
            android:name=".data.jobs.DueReceiver"
            android:exported="false" />

        <!-- Sets the reminder and backup again after a restart, an update, a clock or time zone change, or a change
             to "Alarms & reminders". These system broadcasts reach it without exporting it. -->
        <receiver
            android:name=".data.jobs.RescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

    <!-- Feedback opens the email app; Android 11+ needs to be told Kassa looks for one. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
</manifest>
