<?xml version="1.0" encoding="utf-8"?>
<!-- The starting screen's icon: the disc grows in with a small overshoot, then the K and drawer fade up and settle. One short play (about half a second). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_splash_art">
    <target android:name="disc" android:animation="@animator/splash_disc" />
    <target android:name="mark" android:animation="@animator/splash_mark" />
    <target android:name="drawer" android:animation="@animator/splash_fade" />
    <target android:name="stem" android:animation="@animator/splash_fade" />
    <target android:name="leg" android:animation="@animator/splash_fade" />
</animated-vector>
