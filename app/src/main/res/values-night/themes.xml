<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kassa" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Same parent as the light theme: Theme.SplashScreen takes its colours from resources, and ground differs by night. -->
    <style name="Theme.Kassa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Kassa</item>
    </style>
</resources>
