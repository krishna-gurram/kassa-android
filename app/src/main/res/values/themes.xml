<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kassa" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- What shows while Kassa opens: the icon on the ground colour. MainActivity switches to Theme.Kassa once it is up. -->
    <style name="Theme.Kassa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Kassa</item>
    </style>
</resources>
